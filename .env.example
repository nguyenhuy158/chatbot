# Application
APP_ENV=local
APP_NAME=chatbot
APP_HOST=0.0.0.0
APP_PORT=8000
APP_DEBUG=true
APP_SECRET_KEY=change-me-to-random-string-min-32-chars
APP_BASE_URL=http://localhost:8000

# Database
DATABASE_URL=postgresql+asyncpg://chatbot:chatbot@postgres:5432/chatbot
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# Redis
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# LLM providers
ANTHROPIC_API_KEY=sk-ant-xxx
GOOGLE_API_KEY=xxx
OPENAI_API_KEY=sk-xxx
TAVILY_API_KEY=tvly-xxx

# LLM defaults
LLM_DEFAULT_TIER=main
LLM_CHEAP_MODEL=gemini-2.5-flash
LLM_MAIN_MODEL=claude-haiku-4-5-20251001
LLM_HARD_MODEL=claude-opus-4-7
LLM_MAX_TOKENS=4096
LLM_MAX_ITERATIONS=5

# Embedding
EMBEDDING_MODEL=text-embedding-004
EMBEDDING_DIM=768

# SSO
GOOGLE_CLIENT_ID=xxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=xxx
MICROSOFT_CLIENT_ID=xxx
MICROSOFT_CLIENT_SECRET=xxx
MICROSOFT_TENANT_ID=common

# JWT
JWT_ALGORITHM=HS256
JWT_ACCESS_EXPIRE_MINUTES=15
JWT_REFRESH_EXPIRE_DAYS=7

# Quota (defaults per role per day)
QUOTA_EXTERNAL_MESSAGES=50
QUOTA_INTERNAL_MESSAGES=500
QUOTA_EXTERNAL_TOKENS=50000
QUOTA_INTERNAL_TOKENS=500000
QUOTA_EXTERNAL_COST_USD=0.50
QUOTA_INTERNAL_COST_USD=5.00

# Cache
CACHE_L1_TTL_SECONDS=3600

# Observability
OTEL_EXPORTER_OTLP_ENDPOINT=http://signoz-otel-collector:4318
OTEL_SERVICE_NAME=chatbot
LANGFUSE_PUBLIC_KEY=pk-lf-xxx
LANGFUSE_SECRET_KEY=sk-lf-xxx
LANGFUSE_HOST=https://cloud.langfuse.com

# Object storage
AZURE_STORAGE_CONNECTION_STRING=
AZURE_BLOB_CONTAINER=chatbot-docs

# Tenant (single tenant default)
DEFAULT_TENANT_ID=00000000-0000-0000-0000-000000000001

# Channels (Phase 7)
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=
TELEGRAM_BOT_TOKEN=

# Email reporting (Phase 8)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=chatbot@example.com
SMTP_USE_TLS=false
COST_REPORT_RECIPIENTS=huy@techcoop.vn
